{
  "name": "svg-colorizer",
  "version": "0.5.0",
  "description": "Modify colors in SVG elements for web and server-side applications.",
  "scripts": {
    "build": "npx tsup --config tsup.config.js",
    "build:watch": "npx tsup --config tsup.config.js --watch",
    "test": "npx jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "postversion": "git push && git push --tags",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "keywords": [
    "svg",
    "colorizer",
    "colors",
    "fill",
    "vector",
    "image"
  ],
  "author": "Arman Ghazaryan",
  "license": "MIT",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "exports": {
    "types": {
      "import": "./dist/index.d.ts",
      "require": "./dist/index.d.cts"
    },
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.11",
    "@types/jsdom": "^21.1.6",
    "@types/tinycolor2": "^1.4.6",
    "eslint": "^10.4.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.0.0",
    "tinycolor2": "^1.6.0",
    "ts-jest": "^29.1.2",
    "tsup": "^8.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.60.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arman2409/svg-colorizer"
  },
  "type": "module"
}
